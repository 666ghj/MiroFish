# ===== LLM (required unless MOCK_MODE=true) =====
# Any OpenAI-compatible provider works. OpenRouter is the default for GTM Simulation Lab.
LLM_API_KEY=sk-or-v1-your-openrouter-key-here
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_MODEL_NAME=openai/gpt-4o-mini

# ===== Mock mode =====
# true = every step serves labelled sample data and no API key is needed
MOCK_MODE=false

# ===== Optional: legacy social-simulation flow only =====
# ZEP_API_KEY=your_zep_api_key_here
# LLM_BOOST_API_KEY=your_api_key_here
# LLM_BOOST_BASE_URL=your_base_url_here
# LLM_BOOST_MODEL_NAME=your_model_name_here
