# My Own Researcher — local setup (macOS, Linux, or WSL)
# Full guide: README.md and docs/my-own-researcher.md
#
# From the repository root, after installing dependencies:
#   python3 scripts/configure_local_graph.py
#   codex login                         # choose your ChatGPT account
#   npm run graph:up                    # start local Neo4j in Docker
#   npm run dev                         # frontend, backend, graph service
# Then open http://localhost:3000/?lang=en
#
# The configure script creates .env from this template when absent, generates
# unique LOCAL_GRAPH_TOKEN and LOCAL_NEO4J_PASSWORD, and restricts .env to its
# owner. Existing nonempty secrets are preserved. Do not commit your .env.
# No paid API key is required in this mode; Codex plan eligibility/limits apply.
# Graph storage is local, but inference sends prompts to OpenAI through Codex.

# Recommended providers. Local Graphiti extraction also requires Codex login.
LLM_PROVIDER=codex
GRAPH_PROVIDER=graphiti

# Local graph API and Neo4j. Leave blank here; the configure script fills .env.
LOCAL_GRAPH_URL=http://127.0.0.1:5002
LOCAL_NEO4J_URI=bolt://127.0.0.1:7687
LOCAL_GRAPH_TOKEN=
LOCAL_NEO4J_PASSWORD=
# Neo4j username is neo4j. Keep its password after creating the Docker volume;
# changing only this file does not change the password stored by Neo4j.

# Optional Codex settings. Omit CODEX_MODEL to use the CLI's built-in default model.
# Run `codex login status` to verify authentication; never paste auth tokens here.
# CODEX_BIN=codex
# CODEX_MODEL=your_available_codex_model
# Per-request timeout; try 600 for large extraction/report requests (default 180).
# CODEX_TIMEOUT_SECONDS=600
# Maximum wait for the shared Codex execution queue (default 600).
# CODEX_QUEUE_TIMEOUT_SECONDS=600

# Optional graph processing limits, in seconds (defaults shown).
# LOCAL_GRAPH_WAIT_SECONDS=7200
# LOCAL_GRAPH_EPISODE_TIMEOUT_SECONDS=1800
# LOCAL_GRAPH_DATA_DIR=backend/uploads/local_graph

# Backend defaults to loopback. This is a single-user local application.
# FLASK_HOST=127.0.0.1
# FLASK_PORT=5001
# FLASK_DEBUG=False

# Optional OpenAI-compatible API mode (never used as an automatic fallback).
# Change LLM_PROVIDER above to openai, then uncomment and fill these fields.
# LLM_API_KEY=
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_MODEL_NAME=
# Optional stronger model; leave the whole group unset to reuse the main model.
# LLM_BOOST_API_KEY=
# LLM_BOOST_BASE_URL=
# LLM_BOOST_MODEL_NAME=

# Optional Zep Cloud mode. Change GRAPH_PROVIDER above to zep and set your key.
# Existing projects retain their graph provider; create a new project to switch.
# ZEP_API_KEY=
