# ===== LLM (required unless MOCK_MODE=true) =====
# Any OpenAI-compatible provider works. OpenRouter is the default for GTM Simulation Lab.
LLM_API_KEY=sk-or-v1-your-openrouter-key-here
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_MODEL_NAME=openai/gpt-4o-mini

# ===== Mock mode =====
# true = every step serves labelled sample data and no API key is needed
MOCK_MODE=false

# ===== Idea Studio models (optional; default to LLM_MODEL_NAME) =====
# The analyst that updates the live panel benefits from a stronger model:
# openai/gpt-4.1-mini recorded founder facts more completely in testing (~$0.02 per session).
# IDEA_CHAT_MODEL=openai/gpt-4o-mini
# IDEA_EXTRACT_MODEL=openai/gpt-4.1-mini

# ===== Idea Studio evidence search (optional) =====
# Hacker News and GitHub work without keys. Add one or more web search keys for wider coverage.
TAVILY_API_KEY=
EXA_API_KEY=
# GITHUB_TOKEN=   (raises GitHub search rate limits)

# ===== Optional: legacy social-simulation flow only =====
# ZEP_API_KEY=your_zep_api_key_here
# LLM_BOOST_API_KEY=your_api_key_here
# LLM_BOOST_BASE_URL=your_base_url_here
# LLM_BOOST_MODEL_NAME=your_model_name_here
# IDEA_AGENT_MODEL=        # optional: model for the Idea Studio agent team (defaults to LLM_MODEL_NAME)
