# LLM API配置（支持 OpenAI SDK 格式的任意 LLM API）
# 推荐使用阿里百炼平台qwen-plus模型：https://bailian.console.aliyun.com/
# 注意消耗较大，可先进行小于40轮的模拟尝试
LLM_API_KEY=your_api_key_here
LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_MODEL_NAME=qwen-plus

# ===== ZEP记忆图谱配置 =====
# 每月免费额度即可支撑简单使用：https://app.getzep.com/
ZEP_API_KEY=your_zep_api_key_here

# ===== 加速 LLM 配置（可选）=====
# 注意如果不使用加速配置，env文件中就不要出现下面的配置项
LLM_BOOST_API_KEY=your_api_key_here
LLM_BOOST_BASE_URL=your_base_url_here
LLM_BOOST_MODEL_NAME=your_model_name_here

# ===== 远程/VPS 部署配置（可选）=====
# 将 MiroFish 部署在远程服务器（VPS/云主机）并从外部网络访问时可配置此项：
# 前端 Axios 实例默认回退至绝对地址 "http://localhost:5001"，在远程浏览器中该绝对地址
# 会直接请求访问者本机 localhost，绕过了 Vite 开发服务器对同源 /api 请求的反向代理。
# 若希望前端直接跨域请求服务器后端，可将其设置为服务器公网 IP 或域名（含协议与端口）：
# VITE_API_BASE_URL=http://your_server_ip:5001
# 注意事项：
# 1. 源码部署：npm 脚本在 frontend/ 目录下启动 Vite，默认不会自动读取根目录 .env。
#    可在 frontend/.env 中配置，或启动时显式传入：VITE_API_BASE_URL=http://... npm run dev
# 2. Docker 部署：docker-compose.yml 默认拉取预构建镜像（无 build 字段），
#    修改 .env 后重启即可生效：docker compose down && docker compose up -d（无需 --build）。
# 3. 静态构建：VITE_* 变量在 vite build 编译时内嵌于静态 JS 文件中，运行时容器环境变量无法覆盖。
