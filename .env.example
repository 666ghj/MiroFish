# =============================================================================
# SoSim - fully local configuration
#
# Copy to .env at the REPO ROOT. It must live there: backend/app/config.py
# resolves it from __file__, and each simulation script re-loads it the same
# way, so a systemd EnvironmentFile or docker env_file is NOT equivalent.
#
#   cp .env.example .env
#
# Defaults below assume `scripts/provision_local.sh`, which serves the LLM on
# 8000, embeddings on 8081, FalkorDB on 6379 and the Zep shim on 8088.
# =============================================================================

# ===== LLM (any OpenAI-compatible endpoint) ==================================
# The local vLLM server. The value of LLM_API_KEY is ignored by vLLM but must
# be non-empty or backend/app/config.py refuses to boot.
LLM_API_KEY=local
LLM_BASE_URL=http://127.0.0.1:8000/v1
LLM_MODEL_NAME=local-llm

# ===== Simulation / LLM concurrency ==========================================
# These must be matched to the serving side, not guessed. vLLM runs at most
# --max-num-seqs requests at once (provision_local.sh DEFAULTS it to 16; see the
# note at ZEP_COMPAT_BATCH_CONCURRENCY) and queues the rest, and a queued
# request's wait counts against the client timeout. Both platforms run at the
# same time, so the endpoint sees 2x SIM_LLM_SEMAPHORE.
#
# On a bandwidth-bound box such as DGX Spark, raising these does NOT buy
# throughput: it converts queue waiting into slower decoding for every request,
# so instead of some requests queuing, all of them time out. Match, don't
# overshoot.
#
#   SIM_LLM_SEMAPHORE x 2  <=  vLLM --max-num-seqs
#
# Per-platform cap on concurrent LLM requests (8 x 2 platforms = 16 = one full
# vLLM batch, with no standing queue).
SIM_LLM_SEMAPHORE=8

# Per-request timeout in seconds, and retries after a failure. A retry re-enters
# the same queue, so a high retry count multiplies load exactly when the server
# is already the bottleneck. Keep it low and let the preflight check and the
# zero-action circuit breaker catch a genuinely broken endpoint instead.
SIM_MODEL_TIMEOUT=300
SIM_MODEL_MAX_RETRIES=1

# Seconds the start-up preflight completion may take before the run is failed.
SIM_PREFLIGHT_TIMEOUT=60

# Abort after this many consecutive rounds that activate agents but record no
# action - the signature of a failing model backend. 0 disables the check.
SIM_ZERO_ACTION_ABORT=10

# ===== Accelerated LLM (optional) ============================================
# Leave these COMMENTED OUT. Empty-but-present keys are treated as configured
# and will break the boost path — they must be absent, not blank.
# LLM_BOOST_API_KEY=local
# LLM_BOOST_BASE_URL=http://127.0.0.1:8000/v1
# LLM_BOOST_MODEL_NAME=local-llm-small

# ===== Zep-compatible memory graph (local, Graphiti-backed) ==================
# Points SoSim at the shim in third_party/graphiti instead of Zep Cloud.
# Unset ZEP_BASE_URL to go back to Zep Cloud.
# Do NOT set ZEP_API_URL — the SDK gives it precedence over base_url, so it is
# rejected on purpose.
ZEP_API_KEY=local
ZEP_BASE_URL=http://127.0.0.1:8088/api/v2

# Cloud ingests in well under 600s; a local LLM extracting entities from a few
# hundred chunks does not. Blowing this deadline raises TimeoutError in
# GraphBuilder._wait_for_batch even while ingestion is still progressing.
ZEP_INGESTION_WAIT_TIMEOUT_SECONDS=7200

# ===== Zep shim internals ====================================================
ZEP_COMPAT_API_PREFIX=/api/v2

# Where the shim keeps its graph registry, ontologies and BATCH STATE — the
# record of which episodes of a build already committed.
#
# LEFT UNSET ON PURPOSE. A relative value is resolved against the SHIM'S OWN
# working directory, which provision_local.sh sets to third_party/graphiti/server
# — not the repo root and not data/. The `./data/zep_compat.sqlite3` this file
# used to ship therefore put live runtime state inside the graphiti submodule's
# working tree, which that repo does not gitignore: `git status` reported
# "third_party/graphiti (untracked content)" permanently, and any submodule
# reset would have taken the database with it.
#
# With the key absent, `provision_local.sh setup` appends it as an ABSOLUTE path
# under this repo's own gitignored data/, and `start` prints the file it will
# actually open. If you set it by hand, use an absolute path: a relative one is
# what led someone to open ./data/zep_compat.sqlite3 from the repo root, where
# sqlite3 SILENTLY CREATED an empty database they nearly mutated believing it
# was the live one.
#
# An .env that already carries this key is never rewritten — relocating a live
# database out from under a running shim would strand its batch history.
# ZEP_COMPAT_DB_PATH=/absolute/path/to/repo/data/zep_compat.sqlite3

# Concurrent episodes ingested at once — HALF of the concurrency story. Each
# episode fans out into several LLM calls (extraction, dedup, summarisation)
# bounded by SEMAPHORE_LIMIT, so peak in-flight requests during a graph build is
# the PRODUCT of the two:
#
#   ZEP_COMPAT_BATCH_CONCURRENCY x SEMAPHORE_LIMIT
#
# vLLM admits --max-num-seqs at once and queues the rest, and a queued request's
# wait counts against its timeout. The embeddings server is a second vLLM on the
# same GPU, so leave it headroom:
#
#   ZEP_COMPAT_BATCH_CONCURRENCY x SEMAPHORE_LIMIT  <=  --max-num-seqs / 2
#
# --max-num-seqs is a DEFAULT, not a constant: provision_local.sh uses
# MAX_NUM_SEQS="${MAX_NUM_SEQS:-16}" and the README tells you to sweep it
# through 1/4/8/16/32. The two numbers below are derived from 16 and BOTH have
# to be re-derived if you move it — `provision_local.sh doctor` re-checks the
# product against the current MAX_NUM_SEQS and says so if it no longer fits.
#
# The previous 4 x 6 = 24 against 16 slots is what made a 62-episode build run
# for 50 minutes and then die on a single openai.APITimeoutError. 2 x 4 = 8.
ZEP_COMPAT_BATCH_CONCURRENCY=2
ZEP_COMPAT_LOG_LEVEL=INFO

# ===== Graphiti (inside the shim) ============================================
GRAPHITI_LLM_BASE_URL=http://127.0.0.1:8000/v1
GRAPHITI_LLM_API_KEY=local
GRAPHITI_LLM_MODEL=local-llm
GRAPHITI_LLM_SMALL_MODEL=local-llm
GRAPHITI_LLM_TEMPERATURE=0.0

# Deadline for ONE completion, in seconds. The shim reads this key and hands it
# to its AsyncOpenAI client together with max_retries=0
# (zep_compat/runtime.py, _build_openai_http_client), so a hung extraction fails
# once, in bounded time, and says so. This value is the only thing bounding it.
#
# Why the key exists: left to build its own client, the shim inherited the openai
# SDK's defaults — 600s and 2 silent retries that DO retry APITimeoutError — so
# one extraction that never terminated burned 3 x 600s = 30 minutes producing
# nothing and logging nothing but a pause. That was most of where a 62-episode
# build's 50 minutes went before it reported failed_items=1. 180s is far above a
# healthy extraction on this hardware and low enough that a hung one surfaces
# while the operator is still watching.
GRAPHITI_LLM_REQUEST_TIMEOUT=180

# Cap on ONE completion. BE HONEST ABOUT THIS NUMBER: both values that have run
# in production failed, in different ways, and neither is a fix.
#
#   16384  the shim's own code default (zep_compat/runtime.py) — which is also
#          what an .env that omits this key gets. Result: failed_items=1,
#          openai.APITimeoutError, after ~50 minutes.
#   4096   next build. Result: failed_items=4, json.JSONDecodeError
#          "Expecting value: line 1 column 4149 (char 4148)".
#
# 4148 characters out of a 4096-token completion is 1.01 characters per token.
# English JSON prose runs 3.2–4.0 chars/token, so 4096 tokens of real content
# would be 13,000–16,000 characters. THE ARITHMETIC IS SOLID; WHAT IT IMPLIES IS
# THE LEADING HYPOTHESIS, NOT AN ESTABLISHED FINDING: one character per token
# looks like a stream of single-character tokens — digits and commas — i.e. the
# model emitting a runaway list of integers until the cap cut it off mid-number.
# It assumes the completion really did run to the 4096-token cap rather than
# stopping short, and that this tokenizer's chars/token on genuine extraction
# output sits in the usual range. Nobody has read the offending completion back;
# logging the raw body on a JSONDecodeError would settle it either way.
#
# THE CAP IS NOT THE FIX, and it is no longer the only defence. The cause was
# that every extraction schema emitted unbounded arrays and unbounded strings.
# Those schemas now carry ceilings (max_length on both lists and strings, in
# graphiti_core/prompts/extract_nodes.py, extract_edges.py and dedupe_edges.py).
#
# Two DIFFERENT failures, and the ceilings only address the second — do not
# conflate them:
#   - Generation stops at the cap mid-JSON. The body is incomplete, so it never
#     reaches schema validation at all. What makes this legible is the
#     finish_reason == "length" check in openai_generic_client, which raises a
#     named TruncatedResponseError (deliberately NOT retryable, because the
#     truncation is deterministic) instead of a JSONDecodeError at some absurd
#     character offset. That is the fix for THIS failure, not the ceilings.
#   - The model returns complete JSON that overshoots a ceiling. That is what
#     raises a pydantic ValidationError on parse.
# Whether the ceilings also stop GENERATION depends on the server honouring
# them at decode time, which is NOT established here — see
# GRAPHITI_STRUCTURED_OUTPUT_MODE below. Raise this number and a runaway run
# times out; lower it and an honest one truncates.
#
# 4096 stays as the shipped value only because its failure mode is the cheaper
# one: it fails in seconds and says so in the traceback, where 16384 costs ~50
# minutes per attempt before failing. That is bounded damage, not correctness.
#
# (An earlier version of this comment claimed real extraction responses run to a
# few hundred tokens. The 4096-token truncation disproved that.)
GRAPHITI_LLM_MAX_TOKENS=4096

# Graphiti uses response_format structured output, NOT tool calling.
#
#   json_schema  the schema is sent as a response_format and the server is
#                EXPECTED to enforce it with constrained decoding (vLLM's
#                structured-output backend, normally xgrammar).
#   json_object  the schema is merely injected into the prompt and hoped for.
#
# THAT ENFORCEMENT IS EXPECTED, NOT CONFIRMED, ON THIS HARDWARE. Nothing here
# pins the structured-output backend — vLLM picks one — and xgrammar has
# historically treated array maxItems as unsupported and ignored it at decode
# time, which is exactly the bound the extraction schemas lean on to stop a
# runaway array. The schema ceilings are enforced on PARSE by pydantic either
# way; the open question is only whether they also stop generation.
#
# How to settle it on this box:
#   1. docker logs sosim-llm | grep -iE 'guided|structured.?output|xgrammar|outlines'
#      names the backend vLLM actually chose. (Not `provision_local.sh logs llm`
#      — that follows the stream and would never return.)
#   2. Send one completion whose schema has a deliberately tiny array bound and
#      see whether the server stops the array there or runs straight past it.
#
# Keep json_schema. GRAPHITI_STRUCTURED_OUTPUT_MODE=json_object is the ZERO-CODE
# FALLBACK LEVER if enforcement turns out to be absent and the runaway-array
# truncation comes back: it removes the grammar altogether, so nothing can hold
# the model inside a never-closing array — it stops where an unconstrained model
# stops.
#
# How to tell whether that helped: failed_items drops. And a switch FROM
# JSONDecodeError/APITimeoutError TO a shape or validation error is a SUCCESS
# signal, not a regression — it means generation now terminates and all that is
# left is JSON that does not match the model class. Truncation and timeout mean
# it never terminated at all.
#
# The value is not validated anywhere: graphiti compares it to 'json_object'
# exactly, so a typo ('json-object') silently behaves as json_schema.
GRAPHITI_STRUCTURED_OUTPUT_MODE=json_schema

# Embeddings. Zep Cloud did this server-side; Graphiti needs its own endpoint.
# Served by a second vLLM container in pooling mode (HuggingFace TEI publishes
# no arm64 image — every cpu-* tag is amd64-only).
GRAPHITI_EMBEDDER_BASE_URL=http://127.0.0.1:8081/v1
GRAPHITI_EMBEDDER_API_KEY=local
GRAPHITI_EMBEDDER_MODEL=BAAI/bge-m3
# The embedder's own deadline for one request, in seconds. Same key shape and
# same reason as GRAPHITI_LLM_REQUEST_TIMEOUT above: OpenAIEmbedder also builds
# its own AsyncOpenAI when handed none, so it carried the same 600s-and-2-silent-
# retries default. The shim reads this key and sets max_retries=0 here too.
GRAPHITI_EMBEDDER_REQUEST_TIMEOUT=180
# bge-m3 emits exactly 1024 dims, matching Graphiti's default. CHANGING THIS
# LATER MEANS RE-EMBEDDING THE WHOLE GRAPH — the vector index dimension is
# fixed at creation. Note the embedder silently TRUNCATES longer vectors to
# this width rather than erroring.
EMBEDDING_DIM=1024

# Reranker: 'none' (default) uses RRF fusion and calls no reranker at all.
# 'bge' loads BAAI/bge-reranker-v2-m3 locally (~2.2GB, first run downloads it).
# Never the OpenAI reranker: it scores with hard-coded OpenAI tokenizer IDs
# for True/False, which are meaningless to a Qwen or Llama tokenizer.
GRAPHITI_RERANKER=none

# Graphiti's LLM fan-out cap WITHIN one episode — the other half of the product
# documented at ZEP_COMPAT_BATCH_CONCURRENCY above. Keep
# ZEP_COMPAT_BATCH_CONCURRENCY x SEMAPHORE_LIMIT <= --max-num-seqs / 2.
#
# DANGEROUS DEFAULT: graphiti_core reads this key with a CODE default of 20
# (graphiti_core/helpers.py), not the value written here, and an .env that
# already exists is never rewritten by provision_local.sh. So a box whose .env
# predates this key ingests 4 x 20 = 80 requests deep against 16 slots — the
# same timeout death, with nothing in any config file to point at.
# `provision_local.sh doctor` now reports exactly that; re-run
# `provision_local.sh setup` to have the key appended, or copy it in by hand.
SEMAPHORE_LIMIT=4

# NOT a tuning knob for ingest, despite the name. Only a handful of
# graphiti_core's semaphore_gather call sites pass max_coroutines at all:
# build_communities, add_episode's community-update branch (which the shim never
# reaches — it does not pass update_communities, and that defaults to False),
# get_nodes_and_edges_by_episode, and the multi-graph search fan-out. Every
# semaphore_gather in the EXTRACTION path omits it and so falls back to
# SEMAPHORE_LIMIT, which is therefore the only knob that governs ingest fan-out.
GRAPHITI_MAX_COROUTINES=4

# Graphiti reports to PostHog on init. On an offline box that is a hang risk,
# not just a privacy leak.
GRAPHITI_TELEMETRY_ENABLED=false

# ===== Graph database ========================================================
GRAPHITI_DB_BACKEND=falkordb
FALKORDB_HOST=127.0.0.1
FALKORDB_PORT=6379
FALKORDB_DATABASE=default_db
# Neo4j alternative (set GRAPHITI_DB_BACKEND=neo4j):
# NEO4J_URI=bolt://127.0.0.1:7687
# NEO4J_USER=neo4j
# NEO4J_PASSWORD=password
# NEO4J_DATABASE=neo4j

# ===== Simulation ============================================================
# Each round costs many LLM calls per agent. Start small and measure.
OASIS_DEFAULT_MAX_ROUNDS=10

# ===== Backend / frontend ====================================================
FLASK_HOST=127.0.0.1
FLASK_PORT=5001
# Never set FLASK_DEBUG=true: the Werkzeug reloader forks a second process and
# simulation subprocess tracking (in-memory, per-process) breaks across the fork,
# orphaning OASIS process groups.

# The frontend now uses same-origin relative URLs and Vite proxies /api to the
# backend, so only the frontend port needs to be reachable.
VITE_PROXY_TARGET=http://127.0.0.1:5001
# Vite blocks unknown Host headers. Bare IPs always work; list hostnames here.
# VITE_ALLOWED_HOSTS=sosim.internal,dgx-spark.local

# ===== Offline model cache ===================================================
# A Twitter simulation pulls Twitter/twhin-bert-base (~1GB) from HuggingFace on
# first run; Reddit needs no model. Pre-seed the cache, then pin offline.
HF_HOME=./data/hf-cache
HF_HUB_OFFLINE=1
TRANSFORMERS_OFFLINE=1
HF_HUB_DISABLE_TELEMETRY=1
