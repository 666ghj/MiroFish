# LLM API配置（支持 OpenAI SDK 格式的任意 LLM API）
# 推荐使用阿里百炼平台qwen-plus模型：https://bailian.console.aliyun.com/
# 注意消耗较大，可先进行小于40轮的模拟尝试
LLM_API_KEY=your_api_key_here
LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_MODEL_NAME=qwen-plus

# ===== ZEP记忆图谱配置 =====
# 每月免费额度即可支撑简单使用：https://app.getzep.com/
ZEP_API_KEY=your_zep_api_key_here

# ===== 加速 LLM 配置（可选）=====
# 注意如果不使用加速配置，env文件中就不要出现下面的配置项
LLM_BOOST_API_KEY=your_api_key_here
LLM_BOOST_BASE_URL=your_base_url_here
LLM_BOOST_MODEL_NAME=your_model_name_here

# ===== 配置生成的模型超时（可选）=====
# 准备模拟时，每次模型请求最多等待多少秒，超时后重试（最多3次）。模型很慢时可以调大。
# Seconds to wait for each model request while preparing a simulation (retried up to 3 times). Raise it for slow models.
# LLM_REQUEST_TIMEOUT=300

# ===== 模拟运行时单次模型请求的超时与重试（可选）=====
# 默认沿用 camel 的 180 秒超时 + 3 次静默重试：一个卡住的请求最多会让一轮停约 12 分钟，且备用模型要等到这些重试用完才会接手。
# 调小后卡住的请求会很快失败并转给备用模型，例如 LLM_MODEL_TIMEOUT=60、LLM_MODEL_MAX_RETRIES=1。
# Per-request timeout and silent retries for model calls during a run. camel's defaults (180 s, 3 retries) can hold a round for ~12 minutes
# before an error -- or the backup model -- appears. Lower them, e.g. LLM_MODEL_TIMEOUT=60 and LLM_MODEL_MAX_RETRIES=1. Unset = camel's defaults.
# LLM_MODEL_TIMEOUT=60
# LLM_MODEL_MAX_RETRIES=1

# ===== 最终问卷的并行度（可选）=====
# 运行结束时的问卷每步同时询问多少个Agent。默认等于该平台的模型并发上限（见上）；重试时会逐步减少，但不会低于 3。
# How many agents the end-of-run questions are asked at once. Default: the platform's model concurrency cap (above).
# Retries ask fewer at a time but never fewer than 3.
# LLM_POLL_PARALLELISM=8

# ===== Twitter 推荐系统的嵌入接口（可选）=====
# 默认 OASIS 在本机用 CPU 运行 twhin-bert 给 Twitter 信息流排序：占用约 1 GB 内存和大部分 CPU。设置 LLM_EMBEDDING_BASE_URL 后，
# 只把"文本转向量"这一步交给远程的 OpenAI 风格 /embeddings 接口（排序本身仍由 OASIS 完成）。backend/deploy/modal_embeddings.py 在 Modal 上
# 托管同一个 twhin-bert-base，排序结果与本地运行一致；换成其他嵌入模型则排序不同，结果不能与 twhin-bert 的运行直接比较。
# 请求失败时该轮改用本地词哈希向量，不会中断模拟。详见 docs/behavior-and-ensembles.md。
# Hosted feed-ranker embeddings (optional). Unset = twhin-bert runs locally, as before.
# LLM_EMBEDDING_BASE_URL=https://<workspace>--mirofish-embeddings-embeddings-web.modal.run/v1
# LLM_EMBEDDING_API_KEY=<the token stored in the Modal secret>
# LLM_EMBEDDING_MODEL_NAME=twhin-bert-base
# LLM_EMBEDDING_TIMEOUT=120
# LLM_EMBEDDING_BATCH=64

# ===== 备用模型（可选）=====
# 配置了加速 LLM（LLM_BOOST_*）时，某个平台的模型调用失败（额度用完/限流、请求太大、服务故障、密钥被拒）会自动改用另一个模型重试一次。设为 false 关闭。
# With LLM_BOOST_* set, a call that the platform's model cannot serve (quota, rate limit, request too large, outage, bad key) is retried once on the other model. Set to false to disable.
# LLM_FALLBACK=true
# 专用备用模型：配了它，两个平台失败的调用都改用它重试（优先于上面的"另一个模型"）。需同时设置 KEY 和 MODEL，BASE_URL 缺省沿用 LLM_BASE_URL。
# A dedicated backup (with a generous quota) used by both platforms instead of the other model. Set KEY and MODEL together; BASE_URL defaults to LLM_BASE_URL.
# LLM_FALLBACK_API_KEY=your_api_key_here
# LLM_FALLBACK_BASE_URL=https://...
# LLM_FALLBACK_MODEL_NAME=your_model_name_here
# 备用模型两次调用之间至少间隔多少秒（两个平台共用）。备用模型有"每秒请求数"限制时设置，例如 Mistral 免费档可设 1.2。默认 0（不限）。
# Minimum seconds between calls to the backup model (shared by both platforms). Set it when the backup has a requests-per-second limit, e.g. 1.2 for Mistral's free tier. Default 0 (off).
# LLM_FALLBACK_MIN_INTERVAL=0

# ===== 准备阶段专用模型（可选）=====
# 在"生成Agent人设"、"生成模拟配置"和"生成最终报告"时使用更快/更强的模型；模拟运行仍用上面的 LLM_*。需同时设置 KEY 和 MODEL。
# A faster/stronger model used to generate agent personas, the simulation config and the final report; the run itself still uses LLM_*. Set KEY and MODEL together.
# LLM_PREP_API_KEY=your_api_key_here
# LLM_PREP_BASE_URL=https://api.groq.com/openai/v1
# LLM_PREP_MODEL_NAME=your_model_name_here

# ===== 运行时的模型并发（可选）=====
# 模拟运行时每个平台同时发出的最大模型请求数（默认 30）。服务商返回 HTTP 429（限流/额度）时调小，例如 3。
# Max simultaneous model requests per platform while a simulation runs (default 30). Lower it (e.g. 3) when the provider answers HTTP 429.
# LLM_MAX_CONCURRENCY=30
# 也可以按平台单独设置（优先于上面的值）：Twitter 用主模型、Reddit 用加速模型，两者的限额往往不同。
# Per platform (takes precedence): Twitter uses the main model and Reddit the boost model, whose limits often differ.
# LLM_TWITTER_MAX_CONCURRENCY=1
# LLM_REDDIT_MAX_CONCURRENCY=6

# ===== 行为引擎（可选）=====
# 新生成的模拟默认使用"行为 v2"：智能体与平台的参数会真正影响运行（人设指令、活跃概率、
# 响应延迟、初始关注图、用户编写的定时事件）。把它设为 false 可让所有模拟退回旧的行为，
# 不需要修改任何已有配置（紧急回退开关）。
# Simulations use "behavior v2" by default. Set to false to fall back to the legacy behavior everywhere.
# BEHAVIOR_V2_ENABLED=true
