# LLM API配置（支持 OpenAI SDK 格式的任意 LLM API）
# 推荐使用阿里百炼平台qwen-plus模型：https://bailian.console.aliyun.com/
# 注意消耗较大，可先进行小于40轮的模拟尝试
LLM_API_KEY=your_api_key_here
LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_MODEL_NAME=qwen-plus

# ===== ZEP记忆图谱配置 =====
# 每月免费额度即可支撑简单使用：https://app.getzep.com/
ZEP_API_KEY=your_zep_api_key_here

# ===== 加速 LLM 配置（可选）=====
# 注意如果不使用加速配置，env文件中就不要出现下面的配置项
LLM_BOOST_API_KEY=your_api_key_here
LLM_BOOST_BASE_URL=your_base_url_here
LLM_BOOST_MODEL_NAME=your_model_name_here

# ===== Frontend Deployment Configuration (Optional) =====
# jdavison[2026-04-27]: made some tweaks to support our k8s deployment
# k8s deployment is nested in foundry's root domain, so we need to set the base path accordingly
# Example:
#    https://foundry.pathos.dev -> k8s directs traffic to foundry frontend
#    https://foundry.pathos.dev/mirofish -> k8s directs traffic to mirofish frontend
#    https://foundry.pathos.dev/mirofish/api -> k8s directs traffic to mirofish backend
VITE_BASE_PATH=/mirofish
VITE_MIROFISH_API_KEY=your_api_key_here
VITE_DEFAULT_LOCALE=en
VITE_BACKEND_URL=http://mirofish-backend:8080  # Dev server proxy target (local dev only)
