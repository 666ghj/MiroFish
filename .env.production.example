# DeepSeek（OpenAI-compatible）
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL_NAME=deepseek-v4-flash
GRAPHITI_LLM_MODEL=deepseek-v4-flash

# 本地图谱
ZEP_BACKEND=graphiti
NEO4J_URI=bolt://neo4j:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=

# 本地 Embedding（OpenAI-compatible）
GRAPHITI_EMBEDDING_API_KEY=local-embedding
GRAPHITI_EMBEDDING_BASE_URL=http://embedding:80/v1
GRAPHITI_EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2

# Flask
FLASK_HOST=0.0.0.0
FLASK_PORT=5001
FLASK_DEBUG=false
