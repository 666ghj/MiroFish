# 文本 LLM 首选 Codex Gateway
LLM_API_KEY=
LLM_BASE_URL=http://codex-gateway:8080/v1
LLM_MODEL_NAME=gpt-5.6-luna
GRAPHITI_LLM_MODEL=gpt-5.6-luna
GRAPHITI_OPERATION_TIMEOUT_SECONDS=3600
GRAPH_BUILD_BATCH_SIZE=3

# Codex Gateway
CODEX_GATEWAY_TOKEN=
CODEX_MODEL=gpt-5.6-luna
CODEX_MAX_CONCURRENCY=1
CODEX_QUEUE_SIZE=20
CODEX_REQUEST_TIMEOUT_SECONDS=600

# DeepSeek 回退（仅 Codex Gateway 使用）
FALLBACK_LLM_API_KEY=
FALLBACK_LLM_BASE_URL=https://api.deepseek.com
FALLBACK_LLM_MODEL=deepseek-v4-flash

# 本地图谱
ZEP_BACKEND=graphiti
NEO4J_URI=bolt://neo4j:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=

# 本地 Embedding（OpenAI-compatible）
GRAPHITI_EMBEDDING_API_KEY=local-embedding
GRAPHITI_EMBEDDING_BASE_URL=http://embedding:80/v1
GRAPHITI_EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2

# Flask
FLASK_HOST=0.0.0.0
FLASK_PORT=5001
FLASK_DEBUG=false
DIRECT_GATEWAY_TOKEN=replace-with-a-random-internal-token
DIRECT_CODEX_MODEL=gpt-5.6-luna
DIRECT_REQUEST_TIMEOUT_SECONDS=600
GRAPHITI_LLM_API_KEY=replace-with-the-same-direct-gateway-token
GRAPHITI_LLM_BASE_URL=http://direct-oauth-gateway:8090/v1
GRAPHITI_LLM_MODEL=gpt-5.6-luna
